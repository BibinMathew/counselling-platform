NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=local-development-publishable-key

# Server only. Copy the LOCAL service-role key without committing it.
SUPABASE_SERVICE_ROLE_KEY=
# disabled | simulator | razorpay (Test Mode only)
PAYMENT_MODE=disabled
# Generate distinct random secrets; keep these out of NEXT_PUBLIC_*.
PAYMENT_SIMULATOR_SECRET=
PAYMENT_RECONCILE_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional, local Rancher Desktop test harness only:
LOCAL_SUPABASE_RANCHER=0

# Local notifications only; no real email/WhatsApp provider.
NOTIFICATION_MODE=disabled
NOTIFICATION_APP_ORIGIN=http://127.0.0.1:3000
NOTIFICATION_WORKER_SECRET=

# Phase 8 workspace/notes: local synthetic content only. Messaging is deferred.
COUNSELOR_WORKSPACE_MODE=disabled
PRIVATE_CONTENT_ACTIVE_KEY_ID=
# JSON object mapping retained key IDs to 64-character random hex keys; server only.
PRIVATE_CONTENT_KEYS=

# Phase 9 private feedback and operations; local fictional content only.
FEEDBACK_ADMIN_MODE=disabled
